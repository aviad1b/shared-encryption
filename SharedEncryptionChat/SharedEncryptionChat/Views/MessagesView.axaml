<!-- Displays a userset's messages. -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SharedEncryptionChat.ViewModels"
             xmlns:dvm="using:SharedEncryptionChat.ViewModels.Dummy"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="SharedEncryptionChat.Views.MessagesView"
             x:DataType="vm:MessagesViewModel">

  <Design.DataContext>
    <dvm:DummyMessagesViewModel/>
  </Design.DataContext>

  <ItemsControl>

    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <DockPanel LastChildFill="False"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    
  </ItemsControl>
  
</UserControl>
